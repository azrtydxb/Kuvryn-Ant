{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "publicURL",
    "postgres",
    "rootKey",
    "persistence",
    "storage",
    "auth"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "publicURL": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "shutdownSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 11
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "disk",
            "s3"
          ]
        },
        "s3": {
          "type": "object",
          "properties": {
            "allowInsecureHTTP": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "$ref": "#/definitions/provider"
        },
        "saml": {
          "$ref": "#/definitions/provider"
        },
        "ldap": {
          "$ref": "#/definitions/provider"
        }
      }
    },
    "rootKey": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "activeVersion": {
          "type": "string",
          "minLength": 1
        },
        "previousKeysManifestKey": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "required": [
        "existingSecret",
        "configKey"
      ],
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "configKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    }
  }
}
