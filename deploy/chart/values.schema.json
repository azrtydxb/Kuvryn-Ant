{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "publicURL",
    "postgres",
    "rootKey",
    "persistence",
    "storage",
    "auth"
  ],
  "properties": {
    "federation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "publicURL": { "type": "string", "pattern": "^(https://[^/?#@]+)?$" },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxStreams": { "type": "integer", "minimum": 0 },
            "streamsPerPrincipal": { "type": "integer", "minimum": 0 },
            "streamsPerClient": { "type": "integer", "minimum": 0 },
            "principalRate": { "type": "integer", "minimum": 0 },
            "minTransferRate": { "type": "integer", "minimum": 0 },
            "transferGrace": { "type": "string" },
            "transferTimeout": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "nodePort": {
              "type": ["integer", "null"],
              "minimum": 30000,
              "maximum": 32767
            },
            "annotations": { "type": "object" },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "tlsRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "hostname": { "type": "string" },
            "parentRefs": { "type": "array", "items": { "type": "object" } }
          }
        },
        "ingressPassthrough": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "host": { "type": "string" },
            "annotations": { "type": "object" }
          }
        },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "existingSecret": { "type": "string" } }
        },
        "networkPolicyFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "publicURL": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "shutdownSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 11
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "endpoint": {
              "type": "string",
              "pattern": "^(https?://[^/@\\s]+(/.*)?)?$"
            },
            "protocol": { "enum": ["http/protobuf", "grpc"] },
            "serviceName": { "type": "string", "minLength": 1 },
            "sampleRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcInterval": { "type": "string", "pattern": "^(0|[0-9]+(m|h))$" },
        "gcGrace": { "type": "string", "pattern": "^[0-9]+(m|h)$" },
        "defaultPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxIdle": { "type": "string", "pattern": "^([0-9]+h)?$" },
            "maxAge": { "type": "string", "pattern": "^([0-9]+h)?$" }
          }
        },
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "highPercent": { "type": "integer", "minimum": 2, "maximum": 99 },
            "lowPercent": { "type": "integer", "minimum": 1, "maximum": 98 },
            "capacity": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?\\s?([KMGT]i?B|B)?)?$"
            },
            "interval": { "type": "string", "pattern": "^(0|[0-9]+(m|h))$" },
            "sweepGrace": { "type": "string", "pattern": "^[0-9]+(m|h)$" }
          }
        }
      }
    },
    "auditRetention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retain": { "type": "string", "pattern": "^(0|[0-9]+h)$" },
        "purgeInterval": { "type": "string", "pattern": "^[0-9]+(m|h)$" }
      }
    },
    "trustedProxies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "dbMaxConns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "uploadSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": ["disk", "s3"]
        },
        "s3": {
          "type": "object",
          "properties": {
            "allowInsecureHTTP": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": ["ReadWriteOnce", "ReadWriteOncePod"]
          }
        }
      }
    },
    "upstreamCA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "existingConfigMap": { "type": "string" },
        "mapKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "$ref": "#/definitions/provider"
        },
        "saml": {
          "$ref": "#/definitions/provider"
        },
        "ldap": {
          "$ref": "#/definitions/provider"
        }
      }
    },
    "rootKey": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "activeVersion": {
          "type": "string",
          "minLength": 1
        },
        "previousKeysManifestKey": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "object",
      "required": ["existingSecret", "configKey"],
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "configKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    }
  }
}
