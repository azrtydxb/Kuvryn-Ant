{
  "name": "kuvryn-ant-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:contract": "node scripts/generate.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:contract && tsc --noEmit && vite build",
    "lint": "tsc --noEmit && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "generate:icons": "node scripts/gen-brand-icons.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "simple-icons": "16.35.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
